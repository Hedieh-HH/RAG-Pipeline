# Copy this file to .env and fill in your values.

# Azure Blob Storage
BLOB__CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
BLOB__CONTAINER_NAME=your-container-name

# Azure Document Intelligence 
DOC_INTELLIGENCE__ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
DOC_INTELLIGENCE__API_KEY=your-doc-intelligence-key
DOC_INTELLIGENCE__MODEL_ID=prebuilt-layout

# Azure OpenAI (embeddings) 
OPENAI__ENDPOINT=https://<resource-name>.openai.azure.com/
OPENAI__API_KEY=your-openai-key
OPENAI__API_VERSION=2024-02-01
OPENAI__EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
OPENAI__EMBEDDING_DIMENSIONS=3072
OPENAI__EMBEDDING_BATCH_SIZE=16

# Qdrant 
QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION_NAME=documents

# MongoDB (manifest / pipeline state)
MONGO__URI=mongodb://localhost:27017
MONGO__DATABASE=myrag
MONGO__MANIFEST_COLLECTION=manifest

# Local storage (PDF cache)
LOCAL__PDF_DIR=./data/pdfs

# Chunking 
CHUNKING__CHUNK_SIZE_TOKENS=512
CHUNKING__CHUNK_OVERLAP_TOKENS=50

# Logging
LOG__LEVEL=INFO
LOG__FORMAT=console
